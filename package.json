{
  "name": "wersee",
  "type": "module",
  "productName": "Wersee",
  "private": true,
  "version": "1.0.0",
  "description": "Wersee — Premium Digital Marketplace Desktop App",
  "author": {
    "name": "Wersee",
    "email": "support@wersee.com",
    "url": "https://wersee.com"
  },
  "homepage": "https://wersee.com",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "postbuild": "node scripts/generate-eula-static.mjs && node scripts/generate-profile-static.mjs",
    "test": "vitest run",
    "test:sites": "vitest run src/server/sites",
    "test:ai": "vitest run src/ai/__tests__",
    "test:e2e:ai": "playwright test tests/wersee-ai.spec.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "generate:sitemaps": "node scripts/generate-sitemaps.js",
    "prebuild": "node scripts/generate-sitemaps.js",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "electron-builder --config electron-builder.json",
    "electron:build:win": "electron-builder --win --config electron-builder.json",
    "electron:build:mac": "electron-builder --mac --config electron-builder.json",
    "electron:build:linux": "electron-builder --linux --config electron-builder.json",
    "electron:publish": "electron-builder --win --publish always --config electron-builder.json"
  },
